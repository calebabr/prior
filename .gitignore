# --- Secrets: never commit ---
*.pem
*.key
.env
.env.*
!.env.example
!control_app/.env.mock
bot.env
**/secrets/

# --- Private strategy overlay (scripts/overlay_private.py): never commit ---
# The overlay copies private files over the public stand-in in a BUILD or TEMP copy only. If it is ever run in a
# working tree, these keep its output out of git (the overlaid kalshi_bot files themselves show as modified:
# never commit them; restore with `git checkout -- kalshi_bot`).
kalshi_bot/_overlay.py
control_api/data/cell_expectations.json
control_api/data/fee_schedule.json
control_api/data/shadow_limits.json
_private/
private_checkout/

