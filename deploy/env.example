# Every environment variable the control API + runner reads (DASHBOARD_PLAN.md v3, "Settings").
# PLACEHOLDERS ONLY. Never put real values in this file or anywhere in git.
#
# Where the real values go:
#   Render (main path)  -> service -> Environment (render.yaml declares them; secrets are sync:false)
#   VM (optional path)  -> /etc/kalshi/bot.env, owned root:kalshi, chmod 640 (see deploy/vm/README.md)
#   Your PC (bootstrap) -> only MONGODB_URI + TOTP_ENC_KEY, set in the shell for one command, then closed
#
# Generate JWT_SECRET, TOTP_ENC_KEY and TICK_TOKEN with:
#   python -m control_api.auth.bootstrap --gen-keys

# ---------- Storage (MongoDB Atlas M0 = source of truth) ----------
# "mongo" or "memory". Default: "mongo" if MONGODB_URI is set, else "memory" (dev/tests only; nothing persists).
STORE=mongo
# SECRET. Atlas -> Connect -> Drivers. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority&appName=kalshi-control
MONGODB_DB=kalshi_control

# ---------- Auth ----------
# SECRET. Signs access JWTs. Required unless STORE=memory.
JWT_SECRET=<paste-from---gen-keys>
# SECRET. Fernet key encrypting the TOTP secret at rest. Required unless STORE=memory.
# Must be the SAME value on Render and on the PC where you run the bootstrap CLI.
TOTP_ENC_KEY=<paste-from---gen-keys>
# Comma list of origins allowed by CORS: your Vercel app. Exact match, https, no trailing slash.
# On Render, localhost/127.0.0.1 entries are dropped automatically (warning in the log).
ALLOWED_ORIGIN=https://<your-app>.vercel.app
# Local development only: adds the localhost Vite origins to CORS. Ignored on Render.
# Defaults to true only when STORE=memory. Never set it to true on a VM/production host.
DEV_MODE=

# ---------- Scheduler / keep-awake ----------
# SECRET. cron-job.org sends it as the X-Tick-Token header to POST /api/tick. Unset = tick disabled.
TICK_TOKEN=<paste-from---gen-keys>
# Optional. cron-job.org API key (Console -> Settings). Without it only the self-ping runs.
CRONJOB_API_KEY=<optional-cron-job-org-api-key>
# Optional. Public base URL of this API (self-ping + cron-job.org target).
# Leave EMPTY on Render: it falls back to RENDER_EXTERNAL_URL, which Render sets automatically.
# On a VM: https://<your-domain>
PUBLIC_URL=

# ---------- Alerts ----------
# Optional. ntfy.sh topic. Anyone who knows it can read/post, so make it long and random.
NTFY_TOPIC=<long-random-topic-name>
# Optional. healthchecks.io dead-man ping URL (https://hc-ping.com/<uuid>); SECRET. Unset = no dead-man pings.
# See docs/MONITORING.md. Never commit a real value.
HEALTHCHECKS_PING_URL=
# Optional. Self-hosted ntfy server; default https://ntfy.sh.
NTFY_SERVER=

# ---------- Runner + API ceilings ----------
# "true" in production; tests set "false".
RUNNER_ENABLED=true
# API ceilings applied on top of maker_strategy.validate_config.
MAX_RUN_BUDGET=500
MAX_OPEN_FRAC=0.5
# Must be < 15 on Render (sleep timeout).
MAX_POLL_MINUTES=14
# Ceiling on the arbitrage block's contracts per opportunity (clamped to 1..100 in code). Default 25.
MAX_ARB_CONTRACTS=25

# ---------- Kalshi keys (read by the runner only; never logged or returned) ----------
# SECRET. Demo exchange key (play money). Start here.
KALSHI_DEMO_API_KEY_ID=<demo-key-id>
# SECRET. PEM text. Multi-line is fine in the Render dashboard; in a one-line env file use literal \n.
KALSHI_DEMO_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n<demo-key-body>\n-----END RSA PRIVATE KEY-----
# SECRET. Production (REAL MONEY) key. Leave empty until you deliberately go live.
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY=
# Leave EMPTY. Only the exact value I_UNDERSTAND_REAL_MONEY allows live trading
# (and the app must also be switched to live with 2FA + typing LIVE).
KALSHI_LIVE_CONFIRM=

# ---------- Release / handover (Render dashboard; see docs/RELEASE_PROCESS.md) ----------
# Optional label the API reports as api_version (for example 2026.10.16-1). Empty = the API falls back to its default.
# Changing it in Render restarts the service, so leave it empty unless you want a fixed label.
APP_VERSION=
# SECRET. At least 32 random bytes; signs the short-lived handover token that lets a planned deploy keep LIVE mode.
# Empty or shorter than 32 bytes = handover disabled (every restart drops to demo). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HANDOVER_HMAC_KEY=<random-48-bytes>
# SECRET. Read-only key for GET /api/deploy/status (sent as X-Deploy-Status-Key by the release workflow). Unset = 401.
# Use a different random value from every other key. Also add it as the GitHub secret DEPLOY_STATUS_KEY.
DEPLOY_STATUS_KEY=<random-32-bytes>
# SECRET. Lets the release workflow register and poll a pending release (X-Release-Token). Unset = the release
# endpoints answer 404. Also add it as the GitHub secret RELEASE_TOKEN. Approving a release still needs your 2FA in the app.
RELEASE_TOKEN=<random-32-bytes>

# ---------- Shadow mode (read-only simulation; places no orders) ----------
# Set true to allow the shadow loop; it also needs the 'shadow_enabled' setting on in the app. Default false.
SHADOW_ENABLED=

# ---------- Analytics edge benchmark (optional) ----------
# Path to cell_expectations.json (research win rate / ROI per cell, used for the Analytics "edge verdict").
# Edge-revealing: after the repo split it lives ONLY in the private repo and is supplied as a Render
# SECRET FILE (e.g. /etc/secrets/cell_expectations.json). Empty = control_api/data/cell_expectations.json;
# missing or invalid file = verdicts compare on a default ROI only ("expectations.loaded": false).
CELL_EXPECTATIONS_PATH=

# ---------- Private strategy overlay (BUILD-time only; see deploy/private_overlay.md) ----------
# SECRET. Fine-grained, read-only GitHub token for the private strategy repo. Set it in the Render dashboard
# (Environment), never in git. Empty = demo-only build: the public stand-in is installed and live mode is refused.
PRIVATE_REPO_TOKEN=
# Branch, tag or commit of the private repo the build overlays (default main).
PRIVATE_REPO_REF=main

# ---------- Set by the platform (do NOT set yourself) ----------
# PORT                 Render / Docker: port uvicorn listens on
# RENDER_EXTERNAL_URL  Render: https://<service>.onrender.com
# RENDER, RENDER_SERVICE_ID  Render: their presence turns off DEV_MODE and drops localhost CORS origins
#
# ---------- Used internally (do NOT set) ----------
# KALSHI_ENV, MAKER_LIVE, KALSHI_API_KEY_ID, KALSHI_PRIVATE_KEY: the runner sets these for the
# duration of one pass from the KALSHI_DEMO_* / KALSHI_PROD_* values above, then restores them.
